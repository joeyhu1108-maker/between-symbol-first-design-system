// Console, main game and phone tap page, plus the relay that carries NFC taps from the player's phone to the console.
// printer/server.py drives the local printer and cannot run here: other /api/* paths return 404 and bridge.js falls back to the simulated print.
{
  "name": "between",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
}
