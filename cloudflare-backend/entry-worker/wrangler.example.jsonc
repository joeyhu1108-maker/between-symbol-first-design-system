{
  "name": "between-entry",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "UPSTREAM": "https://YOUR-ONSITE-GATEWAY.example.com"
  },
  "services": [
    {
      "binding": "ARTWORK_BACKEND",
      "service": "between-artwork"
    }
  ]
}
